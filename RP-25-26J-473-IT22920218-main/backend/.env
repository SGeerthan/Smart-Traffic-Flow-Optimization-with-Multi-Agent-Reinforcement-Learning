# Hybrid Input Mode Configuration
# Set to true to use laptop camera (YOLO) for WEST road detection
USE_CAMERA_WEST=true

# Camera device index (0 = default/built-in camera, 1+ for external cameras)
WEST_CAMERA_INDEX=0

# Path to YOLO model weights
WEST_MODEL_PATH=models/best.pt

# YOLO Inference Parameters (tunable for detection debugging)
# Detection confidence threshold (0.0-1.0). Lower = more detections but more false positives
WEST_CONF=0.20

# NMS IoU threshold (0.0-1.0). Controls overlap filtering of boxes
WEST_IOU=0.45

# YOLO inference image size (height/width in pixels). Larger = better accuracy but slower
WEST_IMGSZ=960

# Maximum detections per frame. Reduce if only cars are needed, increase for crowded scenes
WEST_MAX_DET=100

# Enable temporal tracking mode (more stable but slower). Set to "true" to enable
WEST_USE_TRACKING=false

# WEST Metrics Configuration
# ROI for WEST camera as "x1,y1,x2,y2" (empty = full frame)
WEST_ROI=

# Enable rolling smoothing of vehicle counts (reduces flicker)
WEST_SMOOTHING_ENABLED=true

# Number of frames to keep for rolling smoothing
WEST_SMOOTHING_WINDOW=5

# Resize frame width for faster YOLO processing (pixels, 0 = no resize, larger = better accuracy)
# Default 960px recommended to preserve vehicle detail
WEST_RESIZE_WIDTH=960
